---
// src/components/NavBar.astro
import { SITE_TITLE, SITE_TAGLINE, SITE_MENU } from '@/consts';

---
<header id="header-bar">
    <div class="wrapper">
        <nav id="header-nav">
            <ul>
                {
                    SITE_MENU.map((item) => (
                        <li><a href={item.href}>{item.name}</a></li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>